rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function platformAdmin() { return signedIn() && profile().data.is_platform_admin == true; }
    function membershipId(orgId) { return orgId + "_" + request.auth.uid; }
    function membership(orgId) {
      return get(/databases/$(database)/documents/memberships/$(membershipId(orgId)));
    }
    function member(orgId) { return signedIn() && membership(orgId).data.active == true; }
    function manager(orgId) {
      return platformAdmin() || (member(orgId) && membership(orgId).data.role in ["admin", "coordinacion"]);
    }
    function moduleAccess(orgId, moduleName) {
      return manager(orgId) || (member(orgId) && moduleName in membership(orgId).data.allowed_modules);
    }
    function invitation(token) { return get(/databases/$(database)/documents/invitations/$(token)); }
    function validInvitation(token) {
      return signedIn() && token != null &&
        invitation(token).data.status == "pending" &&
        invitation(token).data.expires_at_ms > request.time.toMillis() &&
        invitation(token).data.email == request.auth.token.email;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow update: if platformAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.is_platform_admin == resource.data.is_platform_admin &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active
      );
      allow create: if platformAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.auth.token.email == "emilianovillagra@gmail.com" &&
        request.resource.data.is_platform_admin == true &&
        request.resource.data.active == true
      ) || (
        request.auth.uid == uid && validInvitation(request.resource.data.invite_token) &&
        request.resource.data.is_platform_admin == false &&
        request.resource.data.active == true &&
        request.resource.data.role == invitation(request.resource.data.invite_token).data.role
      );
      allow delete: if platformAdmin();
    }
    match /organizations/{orgId} {
      allow read: if member(orgId) || platformAdmin();
      allow create: if platformAdmin();
      allow update, delete: if manager(orgId);
    }
    match /memberships/{membershipDoc} {
      allow read: if platformAdmin() || request.auth.uid == resource.data.user_id || member(resource.data.organization_id);
      allow write: if platformAdmin() || manager(request.resource.data.organization_id);
      allow create: if validInvitation(request.resource.data.invite_token) &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.organization_id == invitation(request.resource.data.invite_token).data.organization_id &&
        request.resource.data.role == invitation(request.resource.data.invite_token).data.role &&
        request.resource.data.allowed_modules == invitation(request.resource.data.invite_token).data.allowed_modules;
      allow delete: if platformAdmin() || manager(resource.data.organization_id);
    }
    match /invitations/{token} {
      allow create: if manager(request.resource.data.organization_id) &&
        request.resource.data.status == "pending" &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.expires_at_ms > request.time.toMillis() &&
        request.resource.data.expires_at_ms <= request.time.toMillis() + 1209600000;
      allow read: if manager(resource.data.organization_id) ||
        (signedIn() && resource.data.email == request.auth.token.email);
      allow update: if manager(resource.data.organization_id) || (
        validInvitation(token) &&
        request.resource.data.organization_id == resource.data.organization_id &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.allowed_modules == resource.data.allowed_modules &&
        request.resource.data.status == "used" &&
        request.resource.data.used_by == request.auth.uid
      );
      allow delete: if manager(resource.data.organization_id);
    }

    match /voters/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "votantes");
      allow create: if moduleAccess(request.resource.data.organization_id, "votantes");
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /budget_entries/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "presupuesto");
      allow create: if moduleAccess(request.resource.data.organization_id, "presupuesto");
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /activities/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "agenda");
      allow create: if moduleAccess(request.resource.data.organization_id, "agenda");
      allow update, delete: if moduleAccess(resource.data.organization_id, "agenda");
    }
    match /headquarters/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "sedes");
      allow create: if moduleAccess(request.resource.data.organization_id, "sedes");
      allow update, delete: if moduleAccess(resource.data.organization_id, "sedes");
    }
    match /teams/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "sedes");
      allow create: if moduleAccess(request.resource.data.organization_id, "sedes");
      allow update, delete: if moduleAccess(resource.data.organization_id, "sedes");
    }
    match /territorial_referents/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "sedes");
      allow create: if moduleAccess(request.resource.data.organization_id, "sedes");
      allow update, delete: if moduleAccess(resource.data.organization_id, "sedes");
    }
    match /claims/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "gestion");
      allow create: if moduleAccess(request.resource.data.organization_id, "gestion");
      allow update, delete: if moduleAccess(resource.data.organization_id, "gestion");
    }
    match /projects/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "gestion");
      allow create: if moduleAccess(request.resource.data.organization_id, "gestion");
      allow update, delete: if moduleAccess(resource.data.organization_id, "gestion");
    }
    match /proposals/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "propuestas");
      allow create: if moduleAccess(request.resource.data.organization_id, "propuestas");
      allow update, delete: if moduleAccess(resource.data.organization_id, "propuestas");
    }
    match /voter_imports/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "votantes");
      allow create: if moduleAccess(request.resource.data.organization_id, "votantes");
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /audit_log/{id} {
      allow read: if manager(resource.data.organization_id);
      allow create: if member(request.resource.data.organization_id) &&
        request.resource.data.actor_id == request.auth.uid &&
        request.resource.data.entity_type is string &&
        request.resource.data.entity_id is string &&
        request.resource.data.action in ["crear", "modificar", "eliminar"];
      allow update, delete: if false;
    }
    match /notification_reads/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update: if signedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        member(request.resource.data.organization_id);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    match /campaign_tasks/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "tareas");
      allow create: if moduleAccess(request.resource.data.organization_id, "tareas");
      allow update, delete: if moduleAccess(resource.data.organization_id, "tareas");
    }
    match /field_operations/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "operativos");
      allow create: if moduleAccess(request.resource.data.organization_id, "operativos");
      allow update, delete: if moduleAccess(resource.data.organization_id, "operativos");
    }
    match /campaign_events/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "eventos");
      allow create: if moduleAccess(request.resource.data.organization_id, "eventos");
      allow update, delete: if moduleAccess(resource.data.organization_id, "eventos");
    }
    match /communications/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "comunicacion");
      allow create: if moduleAccess(request.resource.data.organization_id, "comunicacion");
      allow update, delete: if moduleAccess(resource.data.organization_id, "comunicacion");
    }
    match /logistics_items/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "logistica");
      allow create: if moduleAccess(request.resource.data.organization_id, "logistica");
      allow update, delete: if moduleAccess(resource.data.organization_id, "logistica");
    }
    match /election_day_assignments/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "fiscalizacion");
      allow create: if moduleAccess(request.resource.data.organization_id, "fiscalizacion");
      allow update, delete: if moduleAccess(resource.data.organization_id, "fiscalizacion");
    }
    match /{collectionName}/{id} {
      allow read: if resource.data.organization_id != null && member(resource.data.organization_id);
      allow create: if request.resource.data.organization_id != null && manager(request.resource.data.organization_id);
      allow update, delete: if resource.data.organization_id != null && manager(resource.data.organization_id);
    }
  }
}
