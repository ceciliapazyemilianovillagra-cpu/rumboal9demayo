rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function platformAdmin() { return signedIn() && profile().data.is_platform_admin == true; }
    function membershipId(orgId) { return orgId + "_" + request.auth.uid; }
    function membership(orgId) {
      return get(/databases/$(database)/documents/memberships/$(membershipId(orgId)));
    }
    function member(orgId) { return signedIn() && membership(orgId).data.active == true; }
    function manager(orgId) {
      return platformAdmin() || (member(orgId) && membership(orgId).data.role in ["admin", "coordinacion"]);
    }
    function moduleAccess(orgId, moduleName) {
      return manager(orgId) || (member(orgId) && moduleName in membership(orgId).data.allowed_modules);
    }
    function invitation(token) { return get(/databases/$(database)/documents/invitations/$(token)); }
    function validInvitation(token) {
      return signedIn() && token != null &&
        invitation(token).data.status == "pending" &&
        invitation(token).data.expires_at_ms > request.time.toMillis() &&
        invitation(token).data.email == request.auth.token.email;
    }
    function authorization() { return get(/databases/$(database)/documents/authorized_access/$(request.auth.token.email)); }
    function validAuthorization() {
      return signedIn() && authorization().data.active == true;
    }
    function publicLink(token) { return get(/databases/$(database)/documents/public_links/$(token)); }
    function validPublicLink(token, moduleName) {
      return signedIn() && token is string && publicLink(token).data.active == true &&
        publicLink(token).data.module == moduleName && publicLink(token).data.expires_at_ms > request.time.toMillis();
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow update: if platformAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.is_platform_admin == resource.data.is_platform_admin &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active
      );
      allow create: if platformAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.auth.token.email == "emilianovillagra@gmail.com" &&
        request.resource.data.is_platform_admin == true &&
        request.resource.data.active == true
      ) || (
        request.auth.uid == uid && validInvitation(request.resource.data.invite_token) &&
        request.resource.data.is_platform_admin == false &&
        request.resource.data.active == true &&
        request.resource.data.role == invitation(request.resource.data.invite_token).data.role
      ) || (
        request.auth.uid == uid && validAuthorization() &&
        request.resource.data.is_platform_admin == false && request.resource.data.active == true &&
        request.resource.data.role == authorization().data.role
      );
      allow delete: if platformAdmin();
    }
    match /organizations/{orgId} {
      allow read: if member(orgId) || platformAdmin();
      allow create: if platformAdmin();
      allow update, delete: if manager(orgId);
    }
    match /memberships/{membershipDoc} {
      allow read: if platformAdmin() || request.auth.uid == resource.data.user_id || member(resource.data.organization_id);
      allow write: if platformAdmin() || manager(request.resource.data.organization_id);
      allow create: if validInvitation(request.resource.data.invite_token) &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.organization_id == invitation(request.resource.data.invite_token).data.organization_id &&
        request.resource.data.role == invitation(request.resource.data.invite_token).data.role &&
        request.resource.data.allowed_modules == invitation(request.resource.data.invite_token).data.allowed_modules;
      allow create: if validAuthorization() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.organization_id == authorization().data.organization_id &&
        request.resource.data.role == authorization().data.role &&
        request.resource.data.allowed_modules == authorization().data.allowed_modules;
      allow delete: if platformAdmin() || manager(resource.data.organization_id);
    }
    match /invitations/{token} {
      allow create: if manager(request.resource.data.organization_id) &&
        request.resource.data.status == "pending" &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.expires_at_ms > request.time.toMillis() &&
        request.resource.data.expires_at_ms <= request.time.toMillis() + 1209600000;
      allow read: if manager(resource.data.organization_id) ||
        (signedIn() && resource.data.email == request.auth.token.email);
      allow update: if manager(resource.data.organization_id) || (
        validInvitation(token) &&
        request.resource.data.organization_id == resource.data.organization_id &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.allowed_modules == resource.data.allowed_modules &&
        request.resource.data.status == "used" &&
        request.resource.data.used_by == request.auth.uid
      );
      allow delete: if manager(resource.data.organization_id);
    }

    match /public_links/{token} {
      allow get: if signedIn() && resource.data.active == true && resource.data.expires_at_ms > request.time.toMillis();
      allow list: if manager(resource.data.organization_id);
      allow create: if manager(request.resource.data.organization_id);
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /authorized_access/{email} {
      allow get: if platformAdmin() || (signedIn() && email == request.auth.token.email);
      allow list: if platformAdmin() || manager(resource.data.organization_id);
      allow create: if manager(request.resource.data.organization_id);
      allow update: if manager(resource.data.organization_id);
      allow delete: if manager(resource.data.organization_id);
    }
    match /access_requests/{uid} {
      allow get: if platformAdmin() || (signedIn() && uid == request.auth.uid);
      allow list: if platformAdmin();
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.user_id == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        (request.resource.data.status == "pending" || (validAuthorization() && request.resource.data.status == "approved"));
      allow update: if platformAdmin() || (signedIn() && uid == request.auth.uid && validAuthorization() &&
        request.resource.data.user_id == request.auth.uid && request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == "approved");
      allow delete: if platformAdmin();
    }

    match /voters/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "votantes");
      allow create: if moduleAccess(request.resource.data.organization_id, "votantes");
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /budget_entries/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "presupuesto");
      allow create: if moduleAccess(request.resource.data.organization_id, "presupuesto");
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /activities/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "agenda");
      allow create: if moduleAccess(request.resource.data.organization_id, "agenda");
      allow update, delete: if moduleAccess(resource.data.organization_id, "agenda");
    }
    match /headquarters/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "sedes") || moduleAccess(resource.data.organization_id, "territorio");
      allow create: if moduleAccess(request.resource.data.organization_id, "sedes") || moduleAccess(request.resource.data.organization_id, "territorio");
      allow update, delete: if moduleAccess(resource.data.organization_id, "sedes") || moduleAccess(resource.data.organization_id, "territorio");
    }
    match /teams/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "sedes");
      allow create: if moduleAccess(request.resource.data.organization_id, "sedes");
      allow update, delete: if moduleAccess(resource.data.organization_id, "sedes");
    }
    match /territorial_referents/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "sedes");
      allow create: if moduleAccess(request.resource.data.organization_id, "sedes");
      allow update, delete: if moduleAccess(resource.data.organization_id, "sedes");
    }
    match /claims/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "gestion");
      allow create: if moduleAccess(request.resource.data.organization_id, "gestion") || (validPublicLink(request.resource.data.public_token, "gestion") && request.resource.data.organization_id == publicLink(request.resource.data.public_token).data.organization_id && request.resource.data.created_via == "public");
      allow update, delete: if moduleAccess(resource.data.organization_id, "gestion");
    }
    match /projects/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "gestion");
      allow create: if moduleAccess(request.resource.data.organization_id, "gestion");
      allow update, delete: if moduleAccess(resource.data.organization_id, "gestion");
    }
    match /proposals/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "propuestas");
      allow create: if moduleAccess(request.resource.data.organization_id, "propuestas");
      allow update, delete: if moduleAccess(resource.data.organization_id, "propuestas");
    }
    match /voter_imports/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "votantes");
      allow create: if moduleAccess(request.resource.data.organization_id, "votantes");
      allow update, delete: if manager(resource.data.organization_id);
    }
    match /audit_log/{id} {
      allow read: if manager(resource.data.organization_id);
      allow create: if (member(request.resource.data.organization_id) || platformAdmin()) &&
        request.resource.data.actor_id == request.auth.uid &&
        request.resource.data.entity_type is string &&
        request.resource.data.entity_id is string &&
        request.resource.data.action in ["crear", "modificar", "eliminar"];
      allow update, delete: if false;
    }
    match /notification_reads/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update: if signedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        member(request.resource.data.organization_id);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    match /campaign_tasks/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "tareas");
      allow create: if moduleAccess(request.resource.data.organization_id, "tareas");
      allow update, delete: if moduleAccess(resource.data.organization_id, "tareas");
    }
    match /field_operations/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "operativos");
      allow create: if moduleAccess(request.resource.data.organization_id, "operativos");
      allow update, delete: if moduleAccess(resource.data.organization_id, "operativos");
    }
    match /campaign_events/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "eventos");
      allow create: if moduleAccess(request.resource.data.organization_id, "eventos");
      allow update, delete: if moduleAccess(resource.data.organization_id, "eventos");
    }
    match /event_attendance/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "eventos");
      allow create: if moduleAccess(request.resource.data.organization_id, "eventos") || (validPublicLink(request.resource.data.public_token, "eventos") && request.resource.data.organization_id == publicLink(request.resource.data.public_token).data.organization_id && request.resource.data.created_via == "public");
      allow update, delete: if moduleAccess(resource.data.organization_id, "eventos");
    }
    match /communications/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "comunicacion");
      allow create: if moduleAccess(request.resource.data.organization_id, "comunicacion");
      allow update, delete: if moduleAccess(resource.data.organization_id, "comunicacion");
    }
    match /logistics_items/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "logistica");
      allow create: if moduleAccess(request.resource.data.organization_id, "logistica") || (validPublicLink(request.resource.data.public_token, "logistica") && request.resource.data.organization_id == publicLink(request.resource.data.public_token).data.organization_id && request.resource.data.created_via == "public");
      allow update, delete: if moduleAccess(resource.data.organization_id, "logistica");
    }
    match /election_day_assignments/{id} {
      allow read: if moduleAccess(resource.data.organization_id, "fiscalizacion");
      allow create: if moduleAccess(request.resource.data.organization_id, "fiscalizacion") || (validPublicLink(request.resource.data.public_token, "fiscalizacion") && request.resource.data.organization_id == publicLink(request.resource.data.public_token).data.organization_id && request.resource.data.created_via == "public");
      allow update, delete: if moduleAccess(resource.data.organization_id, "fiscalizacion");
    }
    function assignedTransfer(data) {
      return signedIn() && (data.driver_user_id == request.auth.uid || data.mobilizer_user_id == request.auth.uid);
    }
    match /mobility_transfers/{id} {
      allow read: if manager(resource.data.organization_id) || assignedTransfer(resource.data);
      allow create, delete: if manager(request.resource.data.organization_id);
      allow update: if manager(resource.data.organization_id) || (assignedTransfer(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "status_updated_at", "last_latitude", "last_longitude", "last_updated_by", "dni_confirmed_at", "updated_at"]) &&
        ((resource.data.status == "pendiente" && request.resource.data.status == "buscada") ||
         (resource.data.status == "buscada" && request.resource.data.status == "en_destino") ||
         (resource.data.status == "en_destino" && request.resource.data.status == "regresada")));
    }
    match /mobility_events/{id} {
      allow read: if manager(resource.data.organization_id) ||
        (signedIn() && (resource.data.driver_user_id == request.auth.uid || resource.data.actor_id == request.auth.uid));
      allow create: if manager(request.resource.data.organization_id) || (signedIn() && request.resource.data.actor_id == request.auth.uid &&
        assignedTransfer(get(/databases/$(database)/documents/mobility_transfers/$(request.resource.data.transfer_id)).data));
      allow update, delete: if false;
    }
    match /mobility_driver_routes/{code} {
      // El código aleatorio funciona como credencial temporal: no se permite listar rutas.
      allow get: if manager(resource.data.organization_id) || resource.data.expires_at_ms > request.time.toMillis();
      allow list: if manager(resource.data.organization_id);
      allow create, delete: if manager(request.resource.data.organization_id);
      allow update: if manager(resource.data.organization_id) ||
        (resource.data.expires_at_ms > request.time.toMillis() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stops", "updated_at"]));
    }
    function nagleWorkspace(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.candidate_name.lower() == "ernesto nagle";
    }
    match /staff_days/{id} {
      allow read: if (member(resource.data.organization_id) || platformAdmin()) && nagleWorkspace(resource.data.organization_id);
      allow create: if manager(request.resource.data.organization_id) && nagleWorkspace(request.resource.data.organization_id) &&
        request.resource.data.starts_ms is number && request.resource.data.ends_ms is number &&
        request.resource.data.ends_ms > request.resource.data.starts_ms &&
        request.resource.data.ends_ms - request.resource.data.starts_ms <= 86400000;
      allow update: if manager(resource.data.organization_id) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "updated_at"]);
      allow delete: if false;
    }
    match /staff_checkins/{id} {
      allow read: if manager(resource.data.organization_id) ||
        (member(resource.data.organization_id) && resource.data.user_id == request.auth.uid);
      allow create: if signedIn() && (member(request.resource.data.organization_id) || platformAdmin()) &&
        nagleWorkspace(request.resource.data.organization_id) && request.resource.data.user_id == request.auth.uid &&
        get(/databases/$(database)/documents/staff_days/$(request.resource.data.day_id)).data.organization_id == request.resource.data.organization_id &&
        get(/databases/$(database)/documents/staff_days/$(request.resource.data.day_id)).data.active == true &&
        get(/databases/$(database)/documents/staff_days/$(request.resource.data.day_id)).data.starts_ms <= request.time.toMillis() &&
        get(/databases/$(database)/documents/staff_days/$(request.resource.data.day_id)).data.ends_ms > request.time.toMillis() &&
        request.resource.data.status in ["Disponible", "Llegué al lugar de trabajo", "Tarea terminada", "Necesito asistencia"] &&
        ((request.resource.data.location_consent == false && request.resource.data.latitude == null && request.resource.data.longitude == null) ||
         (request.resource.data.location_consent == true && request.resource.data.latitude is number && request.resource.data.longitude is number &&
          request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180));
      allow update, delete: if false;
    }
    function legacyCollection(name) {
      return !(name in ["audit_log", "notification_reads", "staff_days", "staff_checkins"]);
    }
    match /{collectionName}/{id} {
      allow read: if legacyCollection(collectionName) && resource.data.organization_id != null && member(resource.data.organization_id);
      allow create: if legacyCollection(collectionName) && request.resource.data.organization_id != null && manager(request.resource.data.organization_id);
      allow update, delete: if legacyCollection(collectionName) && resource.data.organization_id != null && manager(resource.data.organization_id);
    }
  }
}
